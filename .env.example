# Copy this file to .env and fill in the values.
# For local development:
#   VITE_WS_URL=ws://localhost:8000/api/v1/translate/ws
# For production (Render, Railway, etc.) — must use wss:// on HTTPS hosts:
#   VITE_WS_URL=wss://your-backend.onrender.com/api/v1/translate/ws

VITE_WS_URL=wss://your-backend.onrender.com/api/v1/translate/ws
